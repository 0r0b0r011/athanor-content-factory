{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://athanor-content-factory.local/schemas/qa-report.schema.json",
  "title": "QA Report",
  "description": "Quality assurance scoring for a completed content artifact. File: 11_qa_report.yaml. All scores are 0-100 where higher is better (for cognitive_load, higher means load is better matched to the age band). athanor validate rejects reports marked passed that are blocked or carry a blocker fix.",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact", "project_id", "artifact_id", "reviewer", "scores", "required_fixes", "passed", "blocked"],
  "properties": {
    "artifact": { "$ref": "common.schema.json#/definitions/artifact_meta" },
    "project_id": { "$ref": "common.schema.json#/definitions/project_id" },
    "artifact_id": { "type": "string", "description": "Path (relative to the project) of the artifact under review" },
    "reviewer": { "type": "string", "description": "Worker name or human reviewer" },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": ["learning_accuracy", "developmental_fit", "cognitive_load", "resonance", "ethics", "adult_trust", "transmedia_coherence"],
      "properties": {
        "learning_accuracy": { "type": "integer", "minimum": 0, "maximum": 100 },
        "developmental_fit": { "type": "integer", "minimum": 0, "maximum": 100 },
        "cognitive_load": { "type": "integer", "minimum": 0, "maximum": 100 },
        "resonance": { "type": "integer", "minimum": 0, "maximum": 100 },
        "ethics": { "type": "integer", "minimum": 0, "maximum": 100 },
        "adult_trust": { "type": "integer", "minimum": 0, "maximum": 100 },
        "transmedia_coherence": { "type": "integer", "minimum": 0, "maximum": 100 }
      }
    },
    "required_fixes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "description"],
        "properties": {
          "severity": { "type": "string", "enum": ["blocker", "major", "minor", "suggestion"] },
          "description": { "type": "string" },
          "location": { "type": "string" },
          "fix_proposal": { "type": "string" }
        }
      }
    },
    "passed": { "type": "boolean" },
    "blocked": { "type": "boolean", "description": "True if release blocked" },
    "block_reasons": { "type": "array", "items": { "type": "string" } }
  },
  "if": { "type": "object", "properties": { "blocked": { "const": true } } },
  "then": { "type": "object", "required": ["block_reasons"], "properties": { "block_reasons": { "type": "array", "minItems": 1 } } }
}
