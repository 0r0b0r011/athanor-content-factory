{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Feedback Log",
  "description": "Post-publication feedback that patches the genome for the next iteration.",
  "type": "object",
  "required": ["project_id", "what_worked", "what_failed", "genome_patch"],
  "properties": {
    "project_id": { "type": "string" },
    "published_version": { "type": "string" },
    "feedback_period": {
      "type": "object",
      "properties": {
        "start_date": { "type": "string" },
        "end_date": { "type": "string" }
      }
    },
    "what_worked": { "type": "array", "items": { "type": "string" } },
    "what_failed": { "type": "array", "items": { "type": "string" } },
    "resonance_delta": { "type": "array", "items": { "type": "string" } },
    "learning_delta": { "type": "array", "items": { "type": "string" } },
    "format_delta": { "type": "array", "items": { "type": "string" } },
    "genome_patch": {
      "type": "object",
      "description": "Specific changes to apply to the content genome"
    },
    "next_experiment": { "type": "string" }
  }
}
