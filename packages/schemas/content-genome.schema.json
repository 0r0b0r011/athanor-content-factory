{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://athanor-content-factory.local/schemas/content-genome.schema.json",
  "title": "Content Genome",
  "description": "Canonical blueprint for an educational content project. File: 03_content_genome.yaml. All downstream stages read from it; any change makes artifacts that pin the old hash stale.",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact", "metadata", "learner_dna", "knowledge_dna", "resonance_dna", "narrative_dna", "format_dna"],
  "properties": {
    "artifact": { "$ref": "common.schema.json#/definitions/artifact_meta" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id", "concept", "domain", "age_band", "primary_formats"],
      "properties": {
        "project_id": { "$ref": "common.schema.json#/definitions/project_id" },
        "concept": { "type": "string", "description": "Short conceptual title" },
        "domain": { "type": "string", "description": "Subject area, e.g. astronomy, biology, mathematics" },
        "age_band": { "$ref": "common.schema.json#/definitions/age_band" },
        "primary_formats": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "common.schema.json#/definitions/format" } }
      }
    },
    "learner_dna": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cognitive_profile", "emotional_drivers", "identity_need", "pacing", "ambiguity_tolerance", "avoid"],
      "properties": {
        "cognitive_profile": { "type": "string", "description": "What the learner can do cognitively at this stage" },
        "emotional_drivers": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "common.schema.json#/definitions/emotional_driver" } },
        "identity_need": { "type": "string", "description": "What the learner needs to feel about themselves, e.g. 'I am becoming capable'" },
        "pacing": { "type": "string", "description": "Rhythm and tempo of content delivery" },
        "ambiguity_tolerance": { "type": "string", "description": "How much uncertainty the learner can handle" },
        "avoid": { "type": "array", "items": { "type": "string" }, "description": "Anti-patterns to avoid" }
      }
    },
    "knowledge_dna": {
      "type": "object",
      "additionalProperties": false,
      "required": ["learning_objective", "misconception", "accurate_model", "retrieval_prompt", "transfer_task", "teach_back_moment"],
      "properties": {
        "learning_objective": { "type": "string", "description": "What the learner will be able to do, in measurable terms" },
        "misconception": { "type": "string", "description": "The common wrong understanding this content corrects" },
        "accurate_model": { "type": "string", "description": "The correct scientific/educational model" },
        "embodied_activity": { "type": "string", "description": "Physical or hands-on activity that embodies the concept" },
        "retrieval_prompt": { "type": "string", "description": "Question that triggers recall of the concept" },
        "transfer_task": { "type": "string", "description": "Challenge that applies the concept in a new context" },
        "teach_back_moment": { "type": "string", "description": "Opportunity for the learner to explain to another" }
      }
    },
    "resonance_dna": {
      "type": "object",
      "additionalProperties": false,
      "required": ["emotional_promise", "primary_hook", "central_mystery", "ritual", "symbolic_object", "replay_reason"],
      "properties": {
        "emotional_promise": { "type": "string", "description": "One-sentence emotional contract with the learner" },
        "primary_hook": { "$ref": "common.schema.json#/definitions/hook_type" },
        "secondary_hook": { "$ref": "common.schema.json#/definitions/hook_type" },
        "central_mystery": { "type": "string", "description": "The curiosity gap that drives engagement" },
        "ritual": { "type": "string", "description": "Recurring action or frame the learner performs" },
        "symbolic_object": { "type": "string", "description": "Physical or conceptual object that embodies the learning" },
        "replay_reason": { "type": "string", "description": "Why the learner would want to revisit" }
      }
    },
    "narrative_dna": {
      "type": "object",
      "additionalProperties": false,
      "required": ["world_law", "setting", "protagonist_need", "conflict", "failed_attempt", "concept_reveal", "aha_moment", "resolution", "next_question"],
      "properties": {
        "world_law": { "type": "string", "description": "The rule the world operates on" },
        "setting": { "type": "string", "description": "Where the story takes place" },
        "protagonist_need": { "type": "string", "description": "What the main character wants" },
        "conflict": { "type": "string", "description": "What stands in the way" },
        "failed_attempt": { "type": "string", "description": "What happens when they try without understanding the concept" },
        "concept_reveal": { "type": "string", "description": "How the educational concept is discovered" },
        "aha_moment": { "type": "string", "description": "The moment understanding crystallizes" },
        "resolution": { "type": "string", "description": "How the concept resolves the conflict" },
        "next_question": { "type": "string", "description": "The hook for the next episode" }
      }
    },
    "format_dna": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "common.schema.json#/definitions/format" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "length": { "type": "string" },
          "style": { "type": "string" },
          "aspect_ratios": { "type": "array", "items": { "type": "string", "pattern": "^[0-9]+:[0-9]+$" } },
          "artifacts": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
