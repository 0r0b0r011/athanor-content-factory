{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://athanor-content-factory.local/schemas/intent.schema.json",
  "title": "Intent Spec",
  "description": "The raw input that seeds a content project. File: 00_intent.yaml.",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact", "project_id", "concept", "learning_goal", "emotional_goal", "target_age_band", "formats", "success_criteria"],
  "properties": {
    "artifact": { "$ref": "common.schema.json#/definitions/artifact_meta" },
    "project_id": { "$ref": "common.schema.json#/definitions/project_id" },
    "concept": { "type": "string", "minLength": 1 },
    "audience": { "type": "string" },
    "learning_goal": { "type": "string", "minLength": 1, "description": "What the learner will understand after engaging" },
    "emotional_goal": { "type": "string", "minLength": 1, "description": "How the learner should feel during/after" },
    "target_age_band": { "$ref": "common.schema.json#/definitions/age_band" },
    "formats": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/definitions/format" },
      "description": "Output formats this project must produce. Seeds content_genome.metadata.primary_formats."
    },
    "constraints": { "type": "array", "items": { "type": "string" } },
    "success_criteria": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "description": "How success will be measured for this project"
    }
  }
}
