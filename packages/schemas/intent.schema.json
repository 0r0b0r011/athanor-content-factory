{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Intent Spec",
  "description": "The raw input that seeds a content project.",
  "type": "object",
  "required": ["learning_goal", "emotional_goal", "target_age_band", "primary_medium", "success_criteria"],
  "properties": {
    "project_id": { "type": "string" },
    "concept": { "type": "string" },
    "audience": { "type": "string" },
    "learning_goal": { "type": "string", "description": "What the learner will understand after engaging" },
    "emotional_goal": { "type": "string", "description": "How the learner should feel during/after" },
    "target_age_band": { "type": "string" },
    "primary_medium": { "type": "string", "enum": ["book", "video", "app", "classroom", "game", "multi-format"] },
    "constraints": {
      "type": "array",
      "items": { "type": "string" }
    },
    "success_criteria": {
      "type": "array",
      "items": { "type": "string" },
      "description": "How success will be measured for this project"
    }
  }
}
