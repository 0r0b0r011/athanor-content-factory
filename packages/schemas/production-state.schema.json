{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://athanor-content-factory.local/schemas/production-state.schema.json",
  "title": "Production State Machine",
  "description": "Lifecycle record for a project. File: state.yaml. Each history entry pins the artifacts that justified the transition by hash.",
  "type": "object",
  "additionalProperties": false,
  "required": ["project_id", "current_state", "state_history"],
  "properties": {
    "project_id": { "$ref": "common.schema.json#/definitions/project_id" },
    "current_state": { "$ref": "common.schema.json#/definitions/production_state" },
    "state_history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["state", "timestamp"],
        "properties": {
          "state": { "$ref": "common.schema.json#/definitions/production_state" },
          "timestamp": { "type": "string", "format": "date-time" },
          "artifacts": { "type": "array", "items": { "$ref": "common.schema.json#/definitions/artifact_ref" } },
          "actor": { "type": "string" }
        }
      }
    },
    "gate_results": {
      "type": "object",
      "propertyNames": { "$ref": "common.schema.json#/definitions/gate" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["passed"],
        "properties": {
          "passed": { "type": "boolean" },
          "notes": { "type": "string" },
          "checked_at": { "type": "string", "format": "date-time" },
          "checked_by": { "type": "string" }
        }
      }
    }
  }
}
